# Core (required)
PORT=5000
DATABASE_URL=your_postgres_connection_string
JWT_SECRET=your_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI moderation + feed ranking (optional — graceful fallback without it)
ANTHROPIC_API_KEY=

# Payments (optional — demo checkout mode when absent)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Storage (optional — without these, uploads are stored in Postgres
# and served from /api/media/:id; with them, the bucket is created automatically)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads
